# Managed by chezmoi: edit ~/dotfiles/home/dot_bashrc, then `chezmoi apply`
# Linux only (macOS uses zsh). Machine-specific settings go in ~/.bashrc.local.

[ -f /etc/bashrc ] && . /etc/bashrc  # Fedora; Debian's /etc/bash.bashrc is read by bash itself

export GOPATH="$HOME/go"
export EDITOR=vim

# Prepend each directory to PATH once, if it exists
path_prepend() {
  local d
  for d in "$@"; do
    [ -d "$d" ] || continue
    case ":$PATH:" in *":$d:"*) ;; *) PATH="$d:$PATH" ;; esac
  done
}
path_prepend "$GOPATH/bin" "$HOME/.krew/bin" "$HOME/.cargo/bin" "$HOME/bin" "$HOME/.local/bin"
unset -f path_prepend
export PATH

# The rest is for interactive shells only
[[ $- == *i* ]] || return

alias k="kubectl"
alias ll="ls -lah"

HISTSIZE=100000
HISTFILESIZE=100000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend

# fzf: Ctrl-R history, Ctrl-T files, Alt-C cd
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'
if command -v fzf >/dev/null; then
  if fzf_init=$(fzf --bash 2>/dev/null); then
    eval "$fzf_init"
  elif [ -r /usr/share/fzf/shell/key-bindings.bash ]; then
    . /usr/share/fzf/shell/key-bindings.bash
  fi
  unset fzf_init
fi

# Drop-in snippets (Fedora convention), then machine-specific settings
for rc in ~/.bashrc.d/*; do
  [ -f "$rc" ] && . "$rc"
done
unset rc
[ -r ~/.bashrc.local ] && . ~/.bashrc.local  # not in git
